# --- Client (Vite) — exposed to the browser bundle ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Discord OAuth2 (for verify.ibroski.net) — exposed to the client ---
VITE_DISCORD_CLIENT_ID=your-discord-application-client-id

# --- Server-only (Vercel serverless functions) — NEVER expose to the client ---
# Used by api/_lib/supabaseAdmin.ts for authoritative, RLS-bypassing writes.
# Do not prefix with VITE_ (that would bundle them into the client).
# Set the real values in Vercel project env vars and in a local .env.local (gitignored).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required by api/discord-callback.ts (verify.ibroski.net Discord verification):
# DISCORD_CLIENT_ID=          (same as VITE_ version above, for the serverless function)
# DISCORD_CLIENT_SECRET=      (from Discord Developer Portal → OAuth2 → Client Secret)
# DISCORD_REDIRECT_URI=       (must match exactly: https://verify.ibroski.net/api/discord-callback)
# BROSKI_WEBHOOK_SECRET=      (shared secret with BroskiBOT, ≥32 random chars)
# BROSKI_BOT_WEBHOOK_URL=     (e.g. http://<bot-ip>:8000/webhook/verify)
